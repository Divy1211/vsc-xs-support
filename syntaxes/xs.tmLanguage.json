{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "External Subroutine",
    "patterns": [
        {
            "include": "#comments-multiline-doc"
        },
        {
            "include": "#comments-multiline"
        },
        {
            "include": "#comments"
        },
        {
            "include": "#data-types"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#decimal-point"
        },
        {
            "include": "#control-statements"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#rules"
        },
        {
            "include": "#user-defined-functions"
        },
        {
            "include": "#built-in-constants"
        },
        {
            "include": "#class-names"
        },
        {
            "include": "#punctuations"
        }
    ],
    "repository": {
        "doxygen-param": {
            "name": "punctuation.definition.block.tag.xs",
            "match": "\\@param (\\w+) (.+)",
            "captures": {
                "1": { "name": "variable.parameter.xs" },
                "2": { "name": "variable.other.xs" }
            }
        },
        "doxygen-return": {
            "name": "punctuation.definition.block.tag.xs",
            "match": "\\@returns (.+)",
            "captures": {
                "1": { "name": "variable.other.xs" }
            }
        },
        "doxygen-allow-discard": {
            "name": "punctuation.definition.block.tag.xs",
            "match": "\\@allow_discard"
        },
        "doxygen-extern": {
            "name": "punctuation.definition.block.tag.xs",
            "match": "\\@(extern) (const )?(\\w+) (\\w+);",
            "captures": {
                "1": { "name": "keyword.control.xs" },
                "2": { "name": "keyword.control.xs" },
                "3": { "name": "support.type.xs" },
                "4": { "name": "variable.xs" }
            }
        },
        "todo-multiline": {
            "name": "variable.other.xs",
            "begin": "\\b(todo|fixme|note|bug|hack|TODO|FIXME|NOTE|BUG|HACK)\\b",
            "end": "(?=\\*/)"
        },
        "todo": {
            "name": "variable.other.xs",
            "match": "\\b(todo|fixme|note|bug|hack|TODO|FIXME|NOTE|BUG|HACK)\\b.*"
        },
        "comments-multiline-doc": {
            "name": "comment.block.documentation.xs",
            "begin": "/\\*\\*",
            "end": "\\*/",
            "patterns": [
                { "include": "#doxygen-param" },
                { "include": "#doxygen-allow-discard" },
                { "include": "#doxygen-return" },
                { "include": "#doxygen-extern" },
                { "include": "#todo-multiline" }
            ]
        },
        "comments-multiline": {
            "name": "comment.block.xs",
            "begin": "/\\*",
            "end": "\\*/",
            "patterns": [
                { "include": "#todo-multiline" }
            ]
        },
        "comments": {
            "name": "comment.xs",
            "begin": "//",
            "end": "\n",
            "patterns": [
                { "include": "#todo" }
            ]
        },
        "data-types": {
            "name": "storage.type.xs",
            "match": "\\b(void|int|float|bool|String|Vector|string|vector|char|long|double|rule)\\b"
        },
        "operators": {
            "name": "keyword.operator.xs",
            "match": "(\\+|-|\\*|\\/|%|&&|\\|\\||=|>|<|!)"
        },
        "strings": {
            "name": "string.quoted.double.xs",
            "begin": "\"",
            "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.xs" } },
            "end": "(?:(?!\")(?:\\\\.|[^\\\\]))*(\")",
            "endCaptures": {
                "1": { "name": "punctuation.definition.string.end.xs" }
            }
        },
        "numbers": {
            "name": "constant.numeric.xs",
            "match": "\\b[0-9]+\\b"
        },
        "decimal-point": {
            "name": "constant.numeric.decimal.xs",
            "match": "\\.(?=[0-9]+\\b)"
        },
        "control-statements": {
            "name": "keyword.xs",
            "match": "\\b(if|else|while|for|switch|case|default)\\b"
        },
        "keywords": {
            "name": "keyword.xs",
            "match": "\\b(break|continue|include|return|extern|const|class|then|goto|label|dbg|infiniteLoopLimit|infiniteRecursionLimit|breakpoint|static|export|mutable)\\b"
        },
        "rules": {
            "name": "keyword.xs",
            "match": "\\b(minInterval|maxInterval|highFrequency|priority|active|inactive|group|runImmediately)\\b"
        },
        "user-defined-functions": {
            "name": "entity.name.function.xs",
            "match": "[a-zA-Z_]+\\w*(?=[\\s\\r\\n]*\\()"
        },
        "built-in-constants": {
            "name": "constant.language.xs",
            "match": "\\b(true|false)\\b"
        },
        "class-names": {
            "name": "entity.name.class.xs",
            "match": "(?<=class)[\\s\\r\\n]+[a-zA-Z_]+\\w*"
        },
        "punctuations": {
            "name": "punctuation.xs",
            "match": "[.,;:'\"{}\\[\\]()]"
        }
    },
    "scopeName": "source.xs"
}
